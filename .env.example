LOG_LEVEL=INFO
# request_complete/ws_message_complete 이벤트만 걸러 stdout 과 별도로 파일에도 남긴다.
# 코딩 에이전트가 서버 재기동과 무관하게 요청 이력을 조회할 수 있게 하기 위해서다.
ACCESS_LOG_ENABLED=true
ACCESS_LOG_PATH=data/requests.log
ACCESS_LOG_MAX_BYTES=10485760
ACCESS_LOG_BACKUP_COUNT=5
MAX_REQUEST_BODY_BYTES=262144
REQUEST_TIMEOUT_SECONDS=30
AI_REQUEST_TIMEOUT_SECONDS=10

# 현재 제품 경로는 고정 공개 Bearer AIRE_GAME/AIRE_WEB을 사용하므로 아래 값이 없어도
# 동작한다. 빈 DEVICE_CREDENTIAL_PEPPER는 코드의 고정 demo key를 사용한다.
# DEV_GAME_DEVICE_TOKEN은 기존 register-game 경로를 별도로 사용할 때만 필요하다.
DATABASE_URL=sqlite+aiosqlite:///./data/companion.db
DEVICE_CREDENTIAL_PEPPER=
DEV_GAME_DEVICE_TOKEN=
PAIRING_CODE_TTL_SECONDS=300
MAX_DEVICES_PER_PROFILE=20
# /api/v1/admin (테이블별 CRUD, app/routes/admin.py) 전용 고정 토큰. 비어 있으면 그
# 라우터 전체가 503(AdminAuthenticationUnavailable)로 실패한다 — 운영 환경에 노출하려면
# 반드시 채운다.
ADMIN_API_TOKEN=
# /api/v1/integrations/kakao/chat 전용 service credential. 두 값은 충분히 긴 무작위
# 문자열을 사용하고, KAKAO_IDENTITY_PEPPER는 변경 시 기존 Kakao Profile 연결이 끊기므로
# DB 백업과 함께 보관한다.
KAKAO_ADAPTER_TOKEN=
KAKAO_IDENTITY_PEPPER=

# 마코 두뇌의 LLM 공급자. 최소 실행은 외부 호출과 키가 없는 mock이다.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_SECONDS=8
LOCAL_LLM_BASE_URL=http://mtvs2026.work/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=balanced-q4-k-m-mtp
LOCAL_LLM_TIMEOUT_SECONDS=30
# 장기기억 임베딩. mock 은 키워드 검색으로 자동 폴백한다.
# 임베딩 서버는 대사 LLM 과 다른 호스트일 수 있어 base_url·키·User-Agent 를 따로 둔다.
# LOCAL_EMBEDDING_BASE_URL 을 비우면 대사 서버를 쓰고 그때만 대사용 키를 물려받는다.
EMBEDDING_PROVIDER=mock
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
LOCAL_EMBEDDING_MODEL=
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_API_KEY=
LOCAL_EMBEDDING_USER_AGENT=
# 차원 축소를 지원하지 않는 모델(bge-m3 등)은 비워 둔다.
LOCAL_EMBEDDING_DIMENSIONS=
EMBEDDING_TIMEOUT_SECONDS=3
CLASSIFY_TEMPERATURE=0.0
CLASSIFY_MAX_TOKENS=64
DIALOGUE_TEMPERATURE=0.6
DIALOGUE_MAX_TOKENS=160
MEMORY_EXTRACT_MAX_TOKENS=512
MEMORY_SUMMARY_MAX_TOKENS=256
MEMORY_CONSOLIDATE_MAX_TOKENS=1024
COMPANION_PROMPT_VERSION=companion-v9
COMPANION_COMMAND_TTL_SECONDS=30
COMPANION_PENDING_TTL_SECONDS=120
COMPANION_CONVERSATION_IDLE_TTL_SECONDS=1800
COMPANION_MEMORY_MAX_ENTRIES=1000
LLM_STEP_TIMING=true

# 세션과 재시작을 넘는 장기기억. 런타임은 SQLite episodic_memories에 저장한다.
# LONG_TERM_MEMORY_DIR는 0005 마이그레이션이 기존 JSON을 읽을 때만 사용하고 원본은 남긴다.
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_DIR=data/memories
LONG_TERM_MEMORY_MAX_PLAYERS=500
LONG_TERM_EXTRACT_EVERY_N_TURNS=3
LONG_TERM_RECALL_LIMIT=3
LONG_TERM_QUIET_SECONDS=90
LONG_TERM_SESSION_END_SECONDS=600
LONG_TERM_TICK_SECONDS=15

# 개발 재현용 JSONL 전사. canonical Message가 신규 기억 source이므로 기본 비활성화한다.
# opt-in 하더라도 원문 보존은 최대 24시간이다.
TRANSCRIPT_ENABLED=false
TRANSCRIPT_DIR=data/transcripts
TRANSCRIPT_RETENTION_DAYS=1
TRANSCRIPT_MAX_CONVERSATIONS=1000

# Canonical Message/Event 원문과 content 없는 audit ledger의 최대 보존 기간.
USER_MESSAGE_RETENTION_DAYS=7
COMPANION_MESSAGE_RETENTION_DAYS=7
GAME_EVENT_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_SECONDS=3600
MEMORY_WORKER_ENABLED=true
MEMORY_WORKER_INTERVAL_SECONDS=5
MEMORY_WORKER_LEASE_SECONDS=60
MEMORY_WORKER_MAX_ATTEMPTS=3
MEMORY_WORKER_BATCH_SIZE=32
LEGACY_MEMORY_QUARANTINE_DIR=data/memory_quarantine
LEGACY_MEMORY_QUARANTINE_DAYS=7
LEGACY_TRANSCRIPT_QUARANTINE_DIR=data/transcript_quarantine
LEGACY_TRANSCRIPT_QUARANTINE_DAYS=30
# 임시 발판. 게임이 game_context.location_id 를 아직 안 보내는 동안 세계관 질문을 시험할 때만
# 채운다(예: forest_camp).
# 클라이언트가 보내기 시작하면 지운다 — 제거 절차는 docs/temporary-scaffolds.md §1.
COMPANION_DEFAULT_LOCATION_ID=forest_camp
